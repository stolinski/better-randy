{
	"name": "supers",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types --check && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"gen": "wrangler types",
		"gen:schema": "node --experimental-strip-types scripts/export-preset-schema.ts",
		"verify-presets": "node --experimental-strip-types scripts/verify-presets.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.60.1",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^25.9.1",
		"@types/pngjs": "^6.0.5",
		"eslint": "^10.4.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"pngjs": "^7.0.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^4.0.1",
		"svelte": "^5.55.9",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.59.4",
		"vite": "^8.0.14",
		"wrangler": "^4.94.0"
	},
	"dependencies": {
		"@drop-in/graffiti": "^4.28.0",
		"@fontsource/archivo": "^5.2.8",
		"@fontsource/eb-garamond": "^5.2.7",
		"@fontsource/geist": "^5.2.9",
		"@fontsource/geist-mono": "^5.2.8",
		"@fontsource/inter": "^5.2.8",
		"@fontsource/jetbrains-mono": "^5.2.8",
		"@fontsource/old-standard-tt": "^5.2.8",
		"@fontsource/playfair-display": "^5.2.8",
		"@fontsource/space-grotesk": "^5.2.10",
		"@fontsource/space-mono": "^5.2.9",
		"gsap": "^3.15.0",
		"mediabunny": "^1.45.3",
		"typegpu": "^0.11.6",
		"wgpu-matrix": "^3.4.2",
		"zod": "^4.4.3"
	}
}
