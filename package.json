{
	"name": "gfx",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview --port 4173",
		"test": "vitest run",
		"test:browser": "node scripts/test-browser-render.mjs",
		"probe:standard-browser": "node scripts/probe-standard-browser-rendering.mjs",
		"eval:webmcp": "node --experimental-strip-types scripts/webmcp-agent-browser-eval.ts",
		"probe:public-runtime": "node --experimental-strip-types scripts/probe-public-runtime.ts",
		"probe:browser-session": "node --experimental-strip-types scripts/probe-browser-session-integrity.ts",
		"audit:timing": "node --experimental-strip-types scripts/audit-timing-coverage.ts",
		"audit:starter-templates": "node --experimental-strip-types scripts/audit-starter-template-coverage.ts",
		"audit:tracking": "node --experimental-strip-types scripts/audit-tracking-coverage.ts",
		"audit:parity": "node --experimental-strip-types scripts/audit-inspector-parity.ts",
		"audit:planning": "node --experimental-strip-types scripts/audit-planning-state.ts",
		"test:structural": "node --test scripts/check-discoverability.test.mjs scripts/check-legacy-name-dispositions.test.mjs src/lib/utils/pack-registry-source.test.mjs && node --experimental-strip-types scripts/audit-starter-template-coverage.ts && node --experimental-strip-types --test scripts/planning-state-checks.test.ts scripts/change-impact-classifier.test.ts scripts/layout-contract-matrix.test.ts scripts/preset-validation-command.test.ts scripts/derive-gfx-render-matrix-manifest.test.ts scripts/browser-render-verification.test.ts && node scripts/test-structural.mjs",
		"test:discoverability": "node --test scripts/check-discoverability.test.mjs",
		"test:watch": "vitest",
		"prepare": "svelte-kit sync || echo ''",
		"gen:identity": "node --experimental-strip-types scripts/generate-gfx-identity-assets.ts",
		"gen:sounds": "node scripts/gen-foley-sounds.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run lint && npm run check:discoverability && npm run check:names",
		"check:discoverability": "node scripts/check-discoverability.mjs",
		"check:names": "node scripts/check-legacy-name-dispositions.mjs",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --write .",
		"gen:schema": "node --experimental-strip-types scripts/export-preset-schema.ts",
		"gfx": "node --experimental-strip-types scripts/gfx.ts",
		"verify:identity": "node --experimental-strip-types scripts/verify-gfx-identity-legibility.ts",
		"verify-presets": "node --experimental-strip-types scripts/verify-presets.ts",
		"verify:layout-contract": "node --experimental-strip-types scripts/run-gfx-layout-contract-matrix.mjs",
		"verify:browser-render": "node --experimental-strip-types scripts/verify-browser-render-matrix.mjs"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@foleyjs/core": "2.7.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.69.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26.1.1",
		"@types/pngjs": "^6.0.5",
		"eslint": "^10.7.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^17.7.0",
		"pngjs": "^7.0.0",
		"prettier": "^3.9.5",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.2",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.63.0",
		"vite": "^8.1.4",
		"vitest": "~4.1.0"
	},
	"dependencies": {
		"@drop-in/graffiti": "^4.30.0",
		"@fontsource/archivo": "^5.2.8",
		"@fontsource/eb-garamond": "^5.2.7",
		"@fontsource/geist": "^5.2.9",
		"@fontsource/geist-mono": "^5.2.8",
		"@fontsource/inter": "^5.2.8",
		"@fontsource/jetbrains-mono": "^5.2.8",
		"@fontsource/old-standard-tt": "^5.2.8",
		"@fontsource/playfair-display": "^5.2.8",
		"@fontsource/space-grotesk": "^5.2.10",
		"@fontsource/space-mono": "^5.2.9",
		"@sentry/sveltekit": "^10.67.0",
		"gsap": "^3.15.0",
		"html2canvas": "1.4.1",
		"mediabunny": "^1.50.8",
		"playwright": "^1.61.1",
		"typegpu": "^0.11.9",
		"wgpu-matrix": "^3.4.2",
		"zod": "^4.4.3"
	}
}
