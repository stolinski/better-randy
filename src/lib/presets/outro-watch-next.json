{
	"schema": "supers@1",
	"name": "Outro — watch next",
	"description": "Full-frame end card with a decisive closing title, one next-video action, and an uninterrupted end-screen hold. Pack-resolved field, type, accent, and grain keep the same composition useful across every house look and both orientations.",
	"pack": "syntax",
	"state": {
		"transport": {
			"orientation": "horizontal",
			"durationSeconds": 8,
			"fps": 30,
			"format": "webm"
		},
		"backgroundFill": "pack",
		"typography": {
			"fontFamily": "sans"
		},
		"marks": {
			"defaults": {},
			"timings": []
		},
		"surface": {
			"type": "type-hero",
			"variant": "single",
			"content": {
				"title": "THANKS",
				"author": "WATCH NEXT → SIGNAL & NOISE",
				"body": ""
			},
			"enter": {
				"start": 0,
				"duration": 0.05,
				"ease": "smooth",
				"sound": {
					"mute": true
				}
			}
		},
		"textAnimations": [
			{
				"id": "closing-title",
				"target": {
					"kind": "surface",
					"slot": "title"
				},
				"effect": "micro-scale-fade",
				"enter": {
					"start": 0.04,
					"duration": 0.045,
					"ease": "settled",
					"sound": {
						"event": "impact"
					}
				}
			},
			{
				"id": "next-action",
				"target": {
					"kind": "surface",
					"slot": "author"
				},
				"effect": "fade-through",
				"enter": {
					"start": 0.13,
					"duration": 0.04,
					"ease": "settled",
					"sound": {
						"event": "tick"
					}
				}
			}
		],
		"overlays": [],
		"effects": [
			{
				"type": "paper-grain",
				"id": "field-grain",
				"params": {
					"warmth": 0.45,
					"density": 0.3
				}
			}
		],
		"audioCues": []
	}
}
