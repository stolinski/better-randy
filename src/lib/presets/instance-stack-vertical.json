{
	"schema": "hiviz@1",
	"name": "Instance stack — every line",
	"description": "Verification preset for the instance-stack Overlay (motion-primitives Phase 4.2). N spatially-offset copies of one text slot with per-instance lag-window propagation — instance 0 enters first, instance N-1 finishes its motion after instance 0. The vertical-stack variant is the family default per ADR-0020.",
	"pack": "syntax",
	"state": {
		"transport": {
			"orientation": "horizontal",
			"durationSeconds": 6,
			"fps": 30,
			"format": "webm"
		},
		"typography": {
			"fontFamily": "sans",
			"paperColor": "#ffffff",
			"inkColor": "#000000"
		},
		"marks": {
			"defaults": {},
			"timings": []
		},
		"surface": {
			"type": "plain",
			"content": {
				"body": ""
			}
		},
		"overlays": [
			{
				"type": "instance-stack",
				"id": "main",
				"content": {
					"variant": "vertical-stack",
					"text": "EVERY LINE",
					"count": 9,
					"spacing": 1.05,
					"opacityFloor": 0.15,
					"lagWindow": 0.4
				},
				"position": { "anchor": "top-left", "offset": { "x": 0.08, "y": 0.12 } },
				"enter": { "start": 0, "duration": 0.18, "ease": "smooth" },
				"exit": { "start": 0.86, "duration": 0.1, "ease": "smooth" }
			}
		],
		"effects": []
	}
}
