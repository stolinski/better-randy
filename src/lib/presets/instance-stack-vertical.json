{
	"schema": "hiviz@1",
	"name": "Instance stack — syntax echo",
	"description": "Channel bumper using the vertical-stack variant: six stacked echoes of 'SYNTAX' in yellow on deep-black, each instance fading in from transparent as the lag-window propagates top to bottom. Demonstrates the instance-stack pipeline's content-driven spacing, opacityFloor, and lagWindow params against a full-frame dark substrate.",
	"pack": "syntax",
	"state": {
		"transport": {
			"orientation": "horizontal",
			"durationSeconds": 6,
			"fps": 30,
			"format": "webm"
		},
		"backgroundFill": "#040408",
		"typography": {
			"fontFamily": "sans",
			"paperColor": "#000000",
			"inkColor": "#fabf47"
		},
		"marks": {
			"defaults": {},
			"timings": []
		},
		"surface": {
			"type": "plain",
			"content": {
				"body": ""
			},
			"enter": { "start": 0, "duration": 0.06, "ease": "settled" },
			"exit": { "start": 0.88, "duration": 0.045, "ease": "smooth" }
		},
		"overlays": [
			{
				"type": "instance-stack",
				"id": "main",
				"content": {
					"variant": "vertical-stack",
					"text": "SYNTAX",
					"count": 6,
					"spacing": 1.12,
					"opacityFloor": 0.0,
					"lagWindow": 0.42
				},
				"position": { "anchor": "center", "offset": { "x": 0, "y": 0 } },
				"enter": { "start": 0, "duration": 0.06, "ease": "settled" },
				"exit": { "start": 0.88, "duration": 0.045, "ease": "smooth" }
			},
			{
				"type": "watermark",
				"id": "sig",
				"content": {
					"handle": "@syntaxfm",
					"label": "syntax.fm"
				},
				"position": { "anchor": "bottom-right", "offset": { "x": 0.05, "y": 0.05 } },
				"enter": { "start": 0.04, "duration": 0.05, "ease": "settled" },
				"exit": { "start": 0.91, "duration": 0.038, "ease": "smooth" }
			}
		],
		"effects": [
			{
				"type": "paper-grain",
				"id": "frame-grit",
				"params": { "warmth": 0.0, "density": 0.20 }
			}
		]
	}
}
