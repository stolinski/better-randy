{
	"schema": "supers@1",
	"name": "Docu stat build",
	"description": "Three stat-callouts build in reading order over footage — a transparent ADR-0036 stat beat: JAVASCRIPT BY THE NUMBERS, then 2,100,000,000 npm downloads/week, 97% of sites, 11,000,000 devs roll up slot-machine style, land, and hold together before a staggered fade out. Intentional omissions: no collage card, no hard offset shadow, no grit, no backgroundFill — this is a keyed overlay; the footage is the substrate and the mono signature thread is carried by the JetBrains Mono stat values and captions, with values in pack accent #fabf47.",
	"pack": "syntax",
	"kind": "deliverable",
	"state": {
		"transport": {
			"orientation": "horizontal",
			"durationSeconds": 6,
			"fps": 30,
			"format": "webm"
		},
		"typography": {
			"fontFamily": "sans",
			"paperColor": "#0a0a0a",
			"inkColor": "#ffffff"
		},
		"marks": {
			"defaults": {},
			"timings": []
		},
		"surface": {
			"type": "plain",
			"content": {
				"body": ""
			},
			"enter": { "start": 0, "duration": 0.05, "ease": "settled" },
			"exit": { "start": 0.88, "duration": 0.04, "ease": "smooth" },
			"diagram": [
				{
					"type": "label",
					"id": "l-headline",
					"position": { "x": 0.5, "y": 0.3 },
					"text": "JAVASCRIPT BY THE NUMBERS",
					"scale": 2,
					"enter": { "start": 0.07, "duration": 0.05, "ease": "settled" },
					"exit": { "start": 0.88, "duration": 0.04, "ease": "smooth" },
					"animation": {
						"cascade": { "anchor": "surface", "event": "end", "offsetMs": 120 }
					}
				},
				{
					"type": "stat-callout",
					"id": "s-npm",
					"position": { "x": 0.235, "y": 0.52 },
					"from": 0,
					"to": 2100000000,
					"format": "integer",
					"label": "NPM DOWNLOADS / WEEK",
					"scale": 0.85,
					"rollStart": 0.15,
					"rollWindow": 0.25,
					"enter": { "start": 0.15, "duration": 0.05, "ease": "settled" },
					"exit": { "start": 0.82, "duration": 0.04, "ease": "smooth" },
					"animation": {
						"cascade": { "anchor": { "block": "l-headline" }, "event": "end", "offsetMs": 180 }
					}
				},
				{
					"type": "stat-callout",
					"id": "s-sites",
					"position": { "x": 0.5, "y": 0.52 },
					"from": 0,
					"to": 97,
