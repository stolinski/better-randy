					"rollStart": 0.225,
					"rollWindow": 0.23,
					"enter": { "start": 0.225, "duration": 0.05, "ease": "settled" },
					"exit": { "start": 0.84, "duration": 0.04, "ease": "smooth" },
					"animation": {
						"cascade": { "anchor": { "block": "s-npm" }, "event": "end", "offsetMs": 150 }
					}
				},
				{
					"type": "stat-callout",
					"id": "s-devs",
					"position": { "x": 0.765, "y": 0.52 },
					"from": 0,
					"to": 11000000,
					"format": "integer",
					"label": "JS DEVELOPERS",
					"scale": 0.85,
					"rollStart": 0.3,
					"rollWindow": 0.25,
					"enter": { "start": 0.3, "duration": 0.05, "ease": "settled" },
					"exit": { "start": 0.86, "duration": 0.04, "ease": "smooth" },
					"animation": {
						"cascade": { "anchor": { "block": "s-sites" }, "event": "end", "offsetMs": 150 }
					}
				}
			]
		},
