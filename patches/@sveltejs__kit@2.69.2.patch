@@ -532,4 +532,13 @@ function ensureProxies(node, proxies) {
  * @returns {Proxy}
  */
 function createProxy(file_path, is_server) {
-	const proxy = tweak_types(fs.readFileSync(file_path, 'utf8'), is_server);
+	let source;
+	try {
+		source = fs.readFileSync(file_path, 'utf8');
+	} catch (error) {
+		// A route can disappear between the watcher update and this read.
