#!/bin/sh
# Register every commit as a Sentry release (gfx@<sha>) with its commit list,
# so issues and spans slice by version and Sentry can point at suspect commits
# (docs/sentry-dev-flow.md § Versions). Wired via
# `git config core.hooksPath scripts/git-hooks`. Fully best-effort: a missing
# or unauthenticated sentry CLI must never slow or block a commit — the work
# runs detached and silent.
#
# ADR-0053: the release name is `accept-old / write-new`, so new releases take
# the GFX spelling while `supers@<sha>` releases stay queryable.
# `--project supers` is `frozen` — it names the Sentry project that already
# holds every historical event, and renaming it is a change inside Sentry.
command -v sentry >/dev/null 2>&1 || exit 0
sha=$(git rev-parse HEAD)
(
	sentry release create "scott-tolinski-projects/gfx@${sha}" --project supers &&
		sentry release set-commits "scott-tolinski-projects/gfx@${sha}" --local
) >/dev/null 2>&1 &
