#!/bin/sh
# Register every commit as a Sentry release (supers@<sha>) with its commit
# list, so issues and spans slice by version and Sentry can point at suspect
# commits (docs/sentry-dev-flow.md § Versions). Wired via
# `git config core.hooksPath scripts/git-hooks`. Fully best-effort: a missing
# or unauthenticated sentry CLI must never slow or block a commit — the work
# runs detached and silent.
command -v sentry >/dev/null 2>&1 || exit 0
sha=$(git rev-parse HEAD)
(
	sentry release create "scott-tolinski-projects/supers@${sha}" --project supers &&
		sentry release set-commits "scott-tolinski-projects/supers@${sha}" --local
) >/dev/null 2>&1 &
